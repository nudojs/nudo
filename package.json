{
  "name": "nudo-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "ci:version": "changeset version",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "lint:tests": "tsc --noEmit -p tsconfig.test-lint.json",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "infer": "tsx packages/cli/src/index.ts infer",
    "check": "tsx packages/cli/src/index.ts check",
    "docs:dev": "pnpm --filter website run start",
    "docs:build": "pnpm --filter website run build",
    "benchmark": "node benchmark/src/runner.js",
    "benchmark:gate": "node benchmark/src/gate.js",
    "benchmark:baseline": "node benchmark/src/baseline.js",
    "benchmark:ts": "node benchmark/src/typescript-runner.js",
    "benchmark:compare": "node benchmark/src/compare.js"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.8"
  }
}
