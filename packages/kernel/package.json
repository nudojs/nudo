{
  "name": "@nudojs/kernel",
  "version": "0.0.1",
  "description": "Type-as-computation kernel: Term/Pred/Abs with constraint arithmetic",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "bin": {
    "nudo-types": "./src/cli.ts"
