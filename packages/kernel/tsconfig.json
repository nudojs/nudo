{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "baseUrl": "../..",
    "paths": {
      "@nudojs/parser": ["packages/parser/src"],
      "@nudojs/core": ["packages/core/src"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/parser/src/**/*",
    "../../packages/core/src/**/*"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "../../packages/core/src/__tests__/**",
    "../../packages/parser/src/__tests__/**"
  ]
}
