{
  "name": "@nudojs/harvester",
  "version": "0.2.7",
  "engines": {
    "node": ">=20"
  },
  "description": "Harvests TypeScript .d.ts declarations into Nudo env definitions",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/harvester"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "prepublishOnly": "tsup src/index.ts --format esm --dts"
  },
  "dependencies": {
    "@nudojs/core": "workspace:*",
    "typescript": "^5.9.3"
  }
}
