{
  "name": "nudojs",
  "version": "0.3.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Thin installer shell for the `nudo` command — delegates to @nudojs/cli, the CLI of the Nudo type inference engine",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "nudo",
    "nudojs",
    "type-inference",
    "javascript",
    "cli",
    "dts",
    "abstract-interpretation"
  ],
  "bin": {
    "nudo": "./bin/nudo.mjs"
  },
  "files": [
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/nudojs"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/nudojs",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/cli": "workspace:*"
  }
}
