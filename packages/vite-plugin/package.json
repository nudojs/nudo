{
  "name": "vite-plugin-nudo",
  "version": "0.4.3",
  "engines": {
    "node": ">=20"
  },
  "description": "Vite plugin for build-time JavaScript type inference with Nudo",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "vite",
    "vite-plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/vite-plugin",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/core": "workspace:*",
    "@nudojs/service": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "prepublishOnly": "tsup src/index.ts --format esm --dts"
  }
}
