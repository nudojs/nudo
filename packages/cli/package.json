{
  "name": "@nudojs/cli",
  "version": "4.0.0-beta.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Command-line interface for the Nudo type inference engine",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "cli",
    "dts",
    "abstract-interpretation"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nudo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/cli",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@nudojs/core": "workspace:*",
    "@nudojs/parser": "workspace:*",
    "@nudojs/service": "workspace:*",
    "commander": "^15.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  }
}
