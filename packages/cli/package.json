{
  "name": "@nudojs/cli",
  "version": "0.3.1",
  "description": "CLI and evaluator API for the Nudo type inference engine",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "cli",
    "dts",
    "abstract-interpretation"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator-api.d.ts",
      "default": "./dist/evaluator-api.js"
    }
  },
  "bin": {
    "nudo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/cli",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "@nudojs/core": "workspace:*",
    "@nudojs/parser": "workspace:*",
    "@nudojs/service": "workspace:*",
    "@nudojs/env": "workspace:*",
    "@nudojs/harvester": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "build:lib": "tsup src/evaluator-api.ts --format esm --dts",
    "prepublishOnly": "tsup"
  }
}
