{
  "name": "@nudojs/service",
  "version": "4.0.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Shared inference service for Nudo IDE integrations — evaluator, file analysis, completions, and .d.ts generation",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "language-service",
    "dts-generation",
    "analysis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "default": "./dist/analysis.js"
    },
    "./interface": {
      "types": "./dist/interface.d.ts",
      "default": "./dist/interface.js"
    },
    "./dts": {
      "types": "./dist/dts.d.ts",
      "default": "./dist/dts.js"
    },
    "./case": {
      "types": "./dist/case.d.ts",
      "default": "./dist/case.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "default": "./dist/lsp.js"
    },
    "./harvest": {
      "types": "./dist/harvest.d.ts",
      "default": "./dist/harvest.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator/evaluator-api.d.ts",
      "default": "./dist/evaluator/evaluator-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/service"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/service",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/core": "workspace:*",
    "@nudojs/parser": "workspace:*",
    "@nudojs/env": "workspace:*",
    "@nudojs/harvester": "workspace:*",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6"
  },
  "scripts": {
    "build": "tsup src/index.ts src/analysis.ts src/interface.ts src/dts.ts src/case.ts src/lsp.ts src/harvest.ts src/evaluator/evaluator-api.ts --format esm --dts",
    "prepublishOnly": "tsup src/index.ts src/analysis.ts src/interface.ts src/dts.ts src/case.ts src/lsp.ts src/harvest.ts src/evaluator/evaluator-api.ts --format esm --dts"
  }
}
