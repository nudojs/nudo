{
  "name": "@nudojs/service",
  "version": "5.0.0-beta.1",
  "engines": {
    "node": ">=20"
  },
  "description": "Nudo analysis core and emit products: Abs-native file analysis, evaluator host API, interface/dts/schema/guard projections, and session caches",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "language-service",
    "dts-generation",
    "analysis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "default": "./dist/analysis.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator/evaluator-api.d.ts",
      "default": "./dist/evaluator/evaluator-api.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "default": "./dist/emit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/service"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/service",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/core": "workspace:*",
    "@nudojs/parser": "workspace:*",
    "@nudojs/env": "workspace:*",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@nudojs/harvester": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/analysis.ts src/evaluator/evaluator-api.ts src/emit/index.ts --format esm --dts",
    "prepublishOnly": "tsup src/index.ts src/analysis.ts src/evaluator/evaluator-api.ts src/emit/index.ts --format esm --dts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
