{
  "name": "@nudojs/lsp",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Language Server Protocol implementation for the Nudo type inference engine",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "lsp",
    "language-server"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nudo-lsp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./public-api": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/lsp"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/lsp",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/service": "workspace:*",
    "@nudojs/core": "workspace:*",
    "@nudojs/parser": "workspace:*",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "smoke": "node ./scripts/smoke-stdio.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
