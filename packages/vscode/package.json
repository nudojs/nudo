{
  "name": "nudo-vscode",
  "displayName": "Nudo",
  "description": "Nudo type inference engine for VS Code / Cursor",
  "version": "0.3.7",
  "private": true,
  "publisher": "wmzy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nudojs/nudo.git",
    "directory": "packages/vscode"
  },
  "contributes": {
    "commands": [
      {
        "command": "nudo.selectCase",
        "title": "Nudo: Select Case"
      },
      {
        "command": "nudo.contract",
        "title": "Nudo: Show Contract"
      },
      {
        "command": "nudo.contract.draft",
        "title": "Nudo: Draft Contract (code-first)"
      },
      {
        "command": "nudo.contract.emit",
        "title": "Nudo: Persist Contract (@generated)"
      },
      {
        "command": "nudo.coexistence.apply",
        "title": "Nudo: Apply coexistence settings (vs tsserver)"
      }
    ],
    "configuration": {
      "title": "Nudo",
      "properties": {
        "nudo.analysis.mode": {
          "type": "string",
          "enum": ["exports", "directives", "all"],
          "default": "exports",
          "description": "Analysis mode: exports (default) / directives (quiet) / all (every target path). See package.json#nudo.analysis.mode."
        },
        "nudo.coexistence.suggestMuteTsValidation": {
          "type": "boolean",
          "default": true,
          "description": "When true, Nudo may suggest muting tsserver JS validation on nudo-managed files to avoid stacked diagnostics (LSP-G4)."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "javascript",
        "scopes": {
          "property": ["variable.other.property.js"],
          "function": ["entity.name.function.js"],
          "method": ["entity.name.function.js"],
          "variable": ["variable.other.readwrite.js"],
          "parameter": ["variable.parameter.js"],
          "namespace": ["entity.name.namespace.js"],
          "class": ["entity.name.class.js"]
        }
      },
      {
        "language": "typescript",
        "scopes": {
          "property": ["variable.other.property.ts"],
          "function": ["entity.name.function.ts"],
          "method": ["entity.name.function.ts"],
          "variable": ["variable.other.readwrite.ts"],
          "parameter": ["variable.parameter.ts"],
          "namespace": ["entity.name.namespace.ts"],
          "class": ["entity.name.class.ts"]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0"
  },
  "scripts": {
    "build": "tsup src/extension.ts --format cjs --outDir out --external vscode && node ./scripts/bundle-server.mjs",
    "package": "npx @vscode/vsce package --no-dependencies",
    "smoke": "node ./scripts/smoke.mjs"
  }
}
