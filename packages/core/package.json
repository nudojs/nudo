{
  "name": "@nudojs/core",
  "version": "0.3.1",
  "description": "Nudo type system: type-as-computation (Abs) with TypeValue evaluation IR",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "abstract-interpretation",
    "type-system"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exec": {
      "types": "./dist/exec.d.ts",
      "default": "./dist/exec.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/core",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.29.0"
  },
  "devDependencies": {
    "commander": "^13.0.0"
  }
}
