{
  "name": "@nudojs/core",
  "version": "2.1.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Nudo type system: type-as-computation (Abs) with TypeValue evaluation IR",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "nudo",
    "type-inference",
    "javascript",
    "abstract-interpretation",
    "type-system"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exec": {
      "types": "./dist/exec.d.ts",
      "default": "./dist/exec.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nudojs/nudo/tree/main/packages/core",
  "bugs": "https://github.com/nudojs/nudo/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.29.0"
  },
  "devDependencies": {
    "commander": "^13.0.0",
    "debug": "^4.4.3",
    "escape-string-regexp": "^5.0.0",
    "eventemitter3": "^5.0.4",
    "is-plain-obj": "^4.1.0",
    "kleur": "^4.1.5",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "p-limit": "^7.3.2",
    "yocto-queue": "^1.2.2"
  }
}
