{
  "name": "@nudojs/env",
  "version": "0.2.1",
  "description": "ES standard, Web platform, and Node.js API type definitions for the Nudo inference engine",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./es": {
      "types": "./dist/es.d.ts",
      "default": "./dist/es.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudojs/nudo.git",
    "directory": "packages/env"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@nudojs/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/es.ts src/web.ts src/node.ts --format esm --dts",
    "prepublishOnly": "tsup src/es.ts src/web.ts src/node.ts --format esm --dts"
  }
}
