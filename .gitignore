!/docs/reports/
/docs/reports/*
!/docs/reports/face-matrix-baseline.json

.playwright-cli/
**/.playwright-cli/

# gate-major.mjs job-local snapshot (always deleted after --check-baseline)
.changeset/.major-baseline.json
.ai-bug-hunt/

# vitest JSON reporter output (local run artifact, never committed)
.vitest/
